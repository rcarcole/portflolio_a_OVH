RewriteEngine On

# --- Forzar HTTPS ---
RewriteCond %{ENV:HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- URLs limpias para las mini-apps ---
# La carpeta física vive en /apps/<app>, pero la URL sigue siendo /<app>.
# 1) Añade la barra final (mantiene la URL limpia y que los assets relativos resuelvan)
RewriteRule ^(zhara|library|ahorro|mercadona)$ /$1/ [R=301,L]
# 2) Reescritura interna hacia apps/ (el navegador nunca ve "apps/")
RewriteRule ^(zhara|library|ahorro|mercadona)/(.*)$ apps/$1/$2 [L]

# --- Página de error 404 ---
ErrorDocument 404 /error404.html

# --- Cabeceras de seguridad básicas ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Bloquear acceso directo a ficheros sensibles ---
<FilesMatch "^\.(htaccess|htpasswd)">
    Require all denied
</FilesMatch>
# Bloquea toda la carpeta .git (código e historial) si el deploy la deja en www
RedirectMatch 404 /\.git(/|$)
